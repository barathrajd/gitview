---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import { releases } from "../data/releases";
import { href } from "../lib/base";
import { currentVersion } from "../lib/version";
import { inlineCode } from "../lib/inline";

const anchor = (version: string) => `v${version.replaceAll(".", "-")}`;
---

<BaseLayout
  title="Gitview changelog — every release"
  description={`What changed in each Gitview release, from the 0.2.1 refactor to the current version, ${currentVersion}.`}
>
  <Navigation />
  <main class="px-5 pb-24 pt-20 sm:px-8 sm:pt-28">
    <div class="mx-auto max-w-6xl">
      <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-emerald-400">Changelog</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-[-0.045em] text-slate-50 sm:text-5xl">Every Gitview release.</h1>
      <p class="mt-5 max-w-2xl text-base leading-7 text-slate-400">
        Release notes come from the project's <a class="text-emerald-300 underline-offset-4 hover:underline" href="https://github.com/barathrajd/gitview/blob/main/RELEASE.md" target="_blank" rel="noreferrer">RELEASE.md</a>. The latest version is {currentVersion}. See <a class="text-emerald-300 underline-offset-4 hover:underline" href={href("features/")}>features</a> for screenshots.
      </p>

      <div class="mt-12 grid grid-cols-[minmax(0,1fr)] gap-8 lg:mt-16 lg:grid-cols-[220px_minmax(0,1fr)] lg:gap-14">
        <!-- Version list: a sticky column on wide screens, a scrolling row on phones. -->
        <nav aria-label="Releases" class="sticky top-16 min-w-0 z-10 -mx-5 border-y border-white/[0.06] bg-[#050807]/90 px-5 py-3 backdrop-blur-md sm:-mx-8 sm:px-8 lg:top-24 lg:mx-0 lg:self-start lg:border-0 lg:bg-transparent lg:p-0 lg:backdrop-blur-none">
          <p class="hidden font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600 lg:block">Versions</p>
          <ol class="no-scrollbar flex gap-2 overflow-x-auto lg:mt-4 lg:flex-col lg:gap-1 lg:overflow-visible lg:border-l lg:border-white/[0.07]">
            {releases.map((release) => (
              <li class="shrink-0">
                <a
                  href={`#${anchor(release.version)}`}
                  data-release-link={anchor(release.version)}
                  class="release-link group flex items-baseline gap-3 whitespace-nowrap rounded-lg border border-white/[0.07] px-3 py-2 font-mono text-xs text-slate-400 transition hover:border-emerald-300/25 hover:text-slate-200 lg:-ml-px lg:rounded-none lg:border-0 lg:border-l-2 lg:border-transparent lg:py-2.5 lg:pl-4"
                >
                  <span class="text-sm font-semibold text-slate-200 group-[.is-active]:text-emerald-300">{release.version}</span>
                  <span class="hidden text-[10px] text-slate-600 lg:inline">{release.date.replace(/, \d{4}$/, "")}</span>
                  {release.version === currentVersion && (
                    <span class="rounded-full bg-emerald-300/10 px-1.5 py-0.5 text-[9px] uppercase tracking-wider text-emerald-300">latest</span>
                  )}
                </a>
              </li>
            ))}
          </ol>
        </nav>

        <div id="release-panel" class="min-w-0 scroll-mt-32 lg:scroll-mt-28">
          {releases.map((release) => (
            <article id={anchor(release.version)} data-release={anchor(release.version)} class="release scroll-mt-32 pb-12 lg:scroll-mt-28">
              <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
                <h2 class="font-mono text-3xl font-semibold tracking-tight text-slate-50">{release.version}</h2>
                <span class="font-mono text-xs text-slate-500">{release.date}</span>
                {release.version === currentVersion && (
                  <span class="rounded-full border border-emerald-300/25 bg-emerald-300/[0.07] px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-wider text-emerald-300">Latest release</span>
                )}
                {release.status === "planned" && (
                  <span class="rounded-full border border-amber-300/30 bg-amber-300/[0.07] px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-wider text-amber-300">Planned · not released</span>
                )}
              </div>
              <p class="mt-4 max-w-3xl text-lg leading-8 text-slate-300">{inlineCode(release.summary).map((part) => part.code ? <code class="rounded-md bg-white/[0.06] px-1.5 py-0.5 font-mono text-[0.85em] text-emerald-200">{part.text}</code> : part.text)}</p>
              <!-- Styled like `git log`: a + gutter for each change, hairlines between. -->
              <div class="mt-8 overflow-hidden rounded-2xl border border-white/[0.08] bg-[#060b0a]">
                <p class="flex items-center justify-between border-b border-white/[0.06] px-5 py-2.5 font-mono text-[10px] uppercase tracking-[0.16em] text-slate-600">
                  <span>What's new</span>
                  <span>{release.highlights.length} changes</span>
                </p>
                <ul class="divide-y divide-white/[0.05]">
                  {release.highlights.map((item) => (
                    <li class="grid grid-cols-[1.5rem_minmax(0,1fr)] gap-x-2 px-5 py-3.5 text-[15px] leading-7 text-slate-300 transition hover:bg-emerald-300/[0.025]">
                      <span class="select-none font-mono text-sm leading-7 text-emerald-400" aria-hidden="true">+</span>
                      <span>{inlineCode(item).map((part) => part.code ? <code class="rounded-md bg-white/[0.06] px-1.5 py-0.5 font-mono text-[0.84em] text-emerald-200">{part.text}</code> : part.text)}</span>
                    </li>
                  ))}
                </ul>
              </div>
              {release.note && (
                <p class="mt-6 border-l-2 border-amber-300/40 pl-4 text-sm leading-6 text-slate-400"><span class="mr-2 font-mono text-[10px] uppercase tracking-[0.16em] text-amber-300/80">Note</span>{inlineCode(release.note).map((part) => part.code ? <code class="rounded-md bg-white/[0.06] px-1.5 py-0.5 font-mono text-[0.85em] text-amber-100">{part.text}</code> : part.text)}</p>
              )}
              {release.links && (
                <p class="mt-6 flex flex-wrap gap-x-5 gap-y-1 font-mono text-xs">
                  {release.links.map((link) => (
                    <a class="text-emerald-300 transition hover:text-emerald-200" href={link.url} target="_blank" rel="noreferrer">{link.label} ↗</a>
                  ))}
                </p>
              )}
            </article>
          ))}
        </div>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  import { setupReleaseSwitcher } from "../lib/release-switcher";
  setupReleaseSwitcher();
</script>
