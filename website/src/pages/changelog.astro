---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import { releases } from "../data/releases";
import { href } from "../lib/base";
---

<BaseLayout
  title="Gitview changelog — every release"
  description="What changed in each Gitview release, from the 0.2.1 refactor to the current version and the planned 0.6.0."
>
  <Navigation />
  <main class="px-5 pb-24 pt-20 sm:px-8 sm:pt-28">
    <div class="mx-auto max-w-4xl">
      <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-emerald-400">Changelog</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-[-0.045em] text-slate-50 sm:text-5xl">Every Gitview release.</h1>
      <p class="mt-5 max-w-2xl text-base leading-7 text-slate-400">
        Release notes come from the project's <a class="text-emerald-300 underline-offset-4 hover:underline" href="https://github.com/barathrajd/gitview/blob/main/RELEASE.md" target="_blank" rel="noreferrer">RELEASE.md</a>. The latest version is 0.5.0. See <a class="text-emerald-300 underline-offset-4 hover:underline" href={href("features/")}>features</a> for screenshots.
      </p>

      <ol class="mt-14 flex flex-col gap-12">
        {releases.map((release) => (
          <li id={`v${release.version.replaceAll(".", "-")}`} class="scroll-mt-24 border-t border-white/[0.08] pt-8">
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
              <h2 class="font-mono text-2xl font-semibold tracking-tight text-slate-100">{release.version}</h2>
              <span class="font-mono text-xs text-slate-500">{release.date}</span>
              {release.status === "planned" && (
                <span class="rounded-full border border-amber-300/30 bg-amber-300/[0.07] px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-wider text-amber-300">Planned · not released</span>
              )}
            </div>
            <p class="mt-3 text-base leading-7 text-slate-300">{release.summary}</p>
            <ul class="mt-4 list-disc space-y-2 pl-5 text-sm leading-6 text-slate-400 marker:text-slate-700">
              {release.highlights.map((item) => <li>{item}</li>)}
            </ul>
            {release.note && <p class="mt-4 text-sm leading-6 text-slate-500">{release.note}</p>}
            {release.links && (
              <p class="mt-4 flex flex-wrap gap-x-5 gap-y-1 font-mono text-xs">
                {release.links.map((link) => (
                  <a class="text-emerald-300 transition hover:text-emerald-200" href={link.url} target="_blank" rel="noreferrer">{link.label} ↗</a>
                ))}
              </p>
            )}
          </li>
        ))}
      </ol>
    </div>
  </main>
  <Footer />
</BaseLayout>
