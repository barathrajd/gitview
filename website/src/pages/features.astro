---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/Navigation.astro";
import { features } from "../data/features";

import { currentVersion } from "../lib/version";
import Footer from "../components/Footer.astro";
import TerminalDemo from "../components/TerminalDemo.astro";
import TerminalShot from "../components/TerminalShot.astro";
import { href } from "../lib/base";

// Screens captured from the real binary on a throwaway sample repository.
const available = [
  {
    title: "One screen for status, history, and context",
    body: "The worktree groups staged, changed, and untracked files. History shows the commit graph with branch and tag labels, and the inspector shows the selected commit and a worktree summary. The footer lists the keys for the current pane.",
    name: "cockpit",
    label: "Main screen: worktree, history, and inspector",
  },
  {
    title: "Before and after, highlighted",
    body: "Open a file to review syntax-colored Before and After panes with aligned, wrapped lines and line numbers. Select a hunk and stage or unstage it, or switch to raw patch styling or a unified layout with one key.",
    name: "diff",
    label: "File diff: Before and After panes with syntax highlighting",
  },
];
---

<BaseLayout
  title="Gitview features — screens from the terminal"
  description="Every Gitview workflow, from the first release to today, with live demos and screens of the real terminal interface: the agent workspace, history, diffs, staging, commits, branches, and tags."
>
  <Navigation />
  <main class="px-5 pb-24 pt-20 sm:px-8 sm:pt-28">
    <div class="mx-auto max-w-7xl">
      <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-emerald-400">Features</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-[-0.045em] text-slate-50 sm:text-5xl">Everything Gitview does, as it looks in your terminal.</h1>
      <p class="mt-5 max-w-2xl text-base leading-7 text-slate-400">
        Browse the workflows below, with the release that introduced each area. Every frame and transcript comes from the real binary on a sample repository; the demos play those frames in order. The current release is {currentVersion}; the <a class="text-emerald-300 underline-offset-4 hover:underline" href={href("changelog/")}>changelog</a> lists every change.
      </p>

      <nav aria-label="Feature catalogue" class="my-10 flex flex-wrap gap-3 text-sm text-emerald-300">
        {available.map(item => <a href={`#${item.name}`}>{item.title}</a>)}
        {features.map(item => <a href={`#${item.id}`}>{item.title}</a>)}
      </nav>
      <div class="flex flex-col gap-16">
        {available.map(item => <section id={item.name} class="min-w-0 scroll-mt-24">
          <p class="font-mono text-xs text-emerald-300">Since {item.name === "diff" ? "0.4.0" : "0.3.0"}</p>
          <h2 class="mt-3 text-2xl text-slate-100">{item.title}</h2>
          <p class="my-5 max-w-3xl leading-7 text-slate-400">{item.body}</p>
          <TerminalShot name={item.name} label={item.label} />
        </section>)}
        {features.map(item => <section id={item.id} class="min-w-0 scroll-mt-24">
          <p class="font-mono text-xs text-emerald-300">Since {item.since}</p>
          <h2 class="mt-3 text-2xl text-slate-100">{item.title}</h2>
          <p class="my-5 max-w-3xl leading-7 text-slate-400">{item.body}</p>
          {item.id === "control-channel" && (      <TerminalDemo
        id="agent"
        title="gitview --run sh  ·  agent opens a diff"
        frames={[
          { name: "agent-1", keys: "MCP", caption: "The agent asks Gitview to open README.md with select_file." },
          { name: "agent-2", caption: "Gitview opens the diff on your screen, and tells the agent what it will show." },
        ]}
      />
)}
          {item.id === "sessions" && (      <TerminalDemo
        id="sessions"
        title="gitview  ·  review and merge an agent session"
        frames={[
          { name: "sessions-1", keys: "A", caption: "The Sessions page lists the agent's session, one commit ahead of main." },
          { name: "sessions-2", keys: "Enter", caption: "Review the session's commit and the diff it would bring into main." },
          { name: "sessions-3", keys: "m", caption: "Gitview asks before merging, and says when it would refuse." },
          { name: "sessions-4", keys: "y", caption: "Merged into main with a merge commit; the session is now even with main." },
        ]}
      />
)}
          {item.transcript && <pre class="my-5 whitespace-pre-wrap break-words rounded-xl border border-white/10 bg-[#080e0c] p-4 text-xs leading-6 text-slate-300">{item.transcript.join("\n")}</pre>}
          <div class="flex flex-col gap-6">{item.shots?.map(shot => <TerminalShot name={shot.name} label={shot.label} />)}</div>
        </section>)}
          <a href={href("#install")} class="inline-flex items-center gap-2 rounded-xl border border-emerald-300/25 bg-emerald-300/[0.07] px-4 py-3 font-mono text-xs text-emerald-200 transition hover:border-emerald-300/50 hover:bg-emerald-300/[0.12]">Install Gitview <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
