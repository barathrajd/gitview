---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/Navigation.astro";
import Release060 from "../components/Release060.astro";
import Release070 from "../components/Release070.astro";
import Footer from "../components/Footer.astro";
import TerminalShot from "../components/TerminalShot.astro";
import { href } from "../lib/base";

// Screens captured from the real binary on a throwaway sample repository.
const available = [
  {
    title: "One screen for status, history, and context",
    body: "The worktree groups staged, changed, and untracked files. History shows the commit graph with branch and tag labels, and the inspector shows the selected commit and a worktree summary. The footer lists the keys for the current pane.",
    name: "cockpit",
    label: "Main screen: worktree, history, and inspector",
  },
  {
    title: "Before and after, highlighted",
    body: "Open a file to review syntax-colored Before and After panes with aligned, wrapped lines and line numbers. Select a hunk and stage or unstage it, or switch to raw patch styling or a unified layout with one key.",
    name: "diff",
    label: "File diff: Before and After panes with syntax highlighting",
  },
];
---

<BaseLayout
  title="Gitview features — screens from the terminal"
  description="Every Gitview workflow with a screenshot of the real terminal interface: history, diffs, staging, commits, branches, and tags."
>
  <Navigation />
  <main>
    <section class="relative px-5 pb-8 pt-20 sm:px-8 sm:pt-28">
      <div class="mx-auto max-w-7xl">
        <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-emerald-400">Features</p>
        <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-[-0.045em] text-slate-50 sm:text-5xl">Everything Gitview does, as it looks in your terminal.</h1>
        <p class="mt-5 max-w-2xl text-base leading-7 text-slate-400">
          Each screen is captured from the real binary on a sample repository. The first group has been in Gitview since 0.5.0. The second group is new in the current release, 0.6.0. See the <a class="text-emerald-300 underline-offset-4 hover:underline" href={href("changelog/")}>changelog</a> for every release.
        </p>
        <p class="mt-6 font-mono text-[11px] text-slate-500">
          <a class="transition hover:text-slate-300" href="#available">Since 0.5.0</a>
          <span class="mx-2 text-slate-700">/</span>
          <a class="transition hover:text-slate-300" href="#new-in-060">New in 0.6.0</a>
        </p>
      </div>
    </section>

    <section id="available" class="relative px-5 py-16 sm:px-8 sm:py-20">
      <div class="mx-auto max-w-7xl">
        <h2 class="text-2xl font-semibold tracking-[-0.03em] text-slate-100 sm:text-3xl">Since 0.5.0</h2>
        <div class="mt-10 flex flex-col gap-14">
          {available.map((item) => (
            <article>
              <h3 class="text-xl font-semibold tracking-tight text-slate-100">{item.title}</h3>
              <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-400">{item.body}</p>
              <div class="mt-6"><TerminalShot name={item.name} label={item.label} /></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <Release070 />

    <Release060 />

    <section class="px-5 pb-24 sm:px-8">
      <div class="mx-auto max-w-7xl">
        <a href={href("#install")} class="inline-flex items-center gap-2 rounded-xl border border-emerald-300/25 bg-emerald-300/[0.07] px-4 py-3 font-mono text-xs text-emerald-200 transition hover:border-emerald-300/50 hover:bg-emerald-300/[0.12]">Install Gitview <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
