---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/Navigation.astro";
import Release060 from "../components/Release060.astro";
import Release070 from "../components/Release070.astro";
import { currentVersion } from "../lib/version";
import Footer from "../components/Footer.astro";
import TerminalShot from "../components/TerminalShot.astro";
import { href } from "../lib/base";

// The features of each release, newest first. Each panel opens from the
// version list, like the changelog.
const panels = [
  { id: "v0-7-0", version: "0.7.0", label: "Agent workspace", date: "October 30" },
  { id: "v0-6-0", version: "0.6.0", label: "Everyday workflows", date: "October 29" },
  { id: "core", version: "Core", label: "Since 0.5.0", date: "" },
];

// Screens captured from the real binary on a throwaway sample repository.
const available = [
  {
    title: "One screen for status, history, and context",
    body: "The worktree groups staged, changed, and untracked files. History shows the commit graph with branch and tag labels, and the inspector shows the selected commit and a worktree summary. The footer lists the keys for the current pane.",
    name: "cockpit",
    label: "Main screen: worktree, history, and inspector",
  },
  {
    title: "Before and after, highlighted",
    body: "Open a file to review syntax-colored Before and After panes with aligned, wrapped lines and line numbers. Select a hunk and stage or unstage it, or switch to raw patch styling or a unified layout with one key.",
    name: "diff",
    label: "File diff: Before and After panes with syntax highlighting",
  },
];
---

<BaseLayout
  title="Gitview features — screens from the terminal"
  description="Every Gitview workflow, release by release, with live demos and screens of the real terminal interface: the agent workspace, history, diffs, staging, commits, branches, and tags."
>
  <Navigation />
  <main class="px-5 pb-24 pt-20 sm:px-8 sm:pt-28">
    <div class="mx-auto max-w-7xl">
      <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-emerald-400">Features</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-[-0.045em] text-slate-50 sm:text-5xl">Everything Gitview does, as it looks in your terminal.</h1>
      <p class="mt-5 max-w-2xl text-base leading-7 text-slate-400">
        Pick a release to see what it added. Every frame and transcript comes from the real binary on a sample repository; the demos play those frames in order. The current release is {currentVersion}; the <a class="text-emerald-300 underline-offset-4 hover:underline" href={href("changelog/")}>changelog</a> lists every change.
      </p>

      <div class="mt-12 grid grid-cols-[minmax(0,1fr)] gap-8 lg:mt-16 lg:grid-cols-[200px_minmax(0,1fr)] lg:gap-12">
        <nav aria-label="Releases" class="sticky top-16 z-10 -mx-5 min-w-0 border-y border-white/[0.06] bg-[#050807]/90 px-5 py-3 backdrop-blur-md sm:-mx-8 sm:px-8 lg:top-24 lg:mx-0 lg:self-start lg:border-0 lg:bg-transparent lg:p-0 lg:backdrop-blur-none">
          <p class="hidden font-mono text-[10px] uppercase tracking-[0.18em] text-slate-600 lg:block">Releases</p>
          <ol class="no-scrollbar flex gap-2 overflow-x-auto lg:mt-4 lg:flex-col lg:gap-1 lg:overflow-visible lg:border-l lg:border-white/[0.07]">
            {panels.map((panel) => (
              <li class="shrink-0">
                <a
                  href={`#${panel.id}`}
                  data-release-link={panel.id}
                  class="group flex flex-col whitespace-nowrap rounded-lg border border-white/[0.07] px-3 py-2 font-mono text-xs text-slate-400 transition hover:border-emerald-300/25 hover:text-slate-200 lg:-ml-px lg:rounded-none lg:border-0 lg:border-l-2 lg:border-transparent lg:py-2.5 lg:pl-4"
                >
                  <span class="flex items-center gap-2 text-sm font-semibold text-slate-200 group-[.is-active]:text-emerald-300">
                    {panel.version}
                    {panel.version === currentVersion && <span class="rounded-full bg-emerald-300/10 px-1.5 py-0.5 text-[9px] font-normal uppercase tracking-wider text-emerald-300">latest</span>}
                  </span>
                  <span class="hidden text-[10px] text-slate-600 lg:block">{panel.label}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>

        <div id="release-panel" class="min-w-0 scroll-mt-32 lg:scroll-mt-28">
          <article data-release="v0-7-0" class="pb-12">
            <Release070 embedded />
          </article>
          <article data-release="v0-6-0" class="pb-12">
            <Release060 embedded />
          </article>
          <article data-release="core" class="pb-12">
            <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-emerald-400">Since 0.5.0</p>
            <h2 class="mt-4 max-w-3xl text-2xl font-semibold tracking-[-0.03em] text-slate-100 sm:text-3xl">The core of Gitview</h2>
            <div class="mt-10 flex flex-col gap-14">
              {available.map((item) => (
                <section>
                  <h3 class="text-xl font-semibold tracking-tight text-slate-100">{item.title}</h3>
                  <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-400">{item.body}</p>
                  <div class="mt-6"><TerminalShot name={item.name} label={item.label} /></div>
                </section>
              ))}
            </div>
          </article>

          <a href={href("#install")} class="inline-flex items-center gap-2 rounded-xl border border-emerald-300/25 bg-emerald-300/[0.07] px-4 py-3 font-mono text-xs text-emerald-200 transition hover:border-emerald-300/50 hover:bg-emerald-300/[0.12]">Install Gitview <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  import { setupReleaseSwitcher } from "../lib/release-switcher";
  setupReleaseSwitcher();
</script>
