---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "../components/Navigation.astro";
import { features } from "../data/features";

import { currentVersion } from "../lib/version";
import Footer from "../components/Footer.astro";
import TerminalDemo from "../components/TerminalDemo.astro";
import TerminalShot from "../components/TerminalShot.astro";
import { href } from "../lib/base";

// Screens captured from the real binary on a throwaway sample repository.
const available = [
  {
    title: "One screen for status, history, and context",
    body: "The worktree groups staged, changed, and untracked files. History shows the commit graph with branch and tag labels, and the inspector shows the selected commit and a worktree summary. The footer lists the keys for the current pane.",
    name: "cockpit",
    label: "Main screen: worktree, history, and inspector",
  },
  {
    title: "Before and after, highlighted",
    body: "Open a file to review syntax-colored Before and After panes with aligned, wrapped lines and line numbers. Select a hunk and stage or unstage it, or switch to raw patch styling or a unified layout with one key.",
    name: "diff",
    label: "File diff: Before and After panes with syntax highlighting",
  },
];
const entries = [
  ...available.map(item => ({ id: item.name, title: item.title, body: item.body, since: item.name === "diff" ? "0.4.0" : "0.3.0" })),
  ...features,
];
---

<BaseLayout
  title="Gitview features — screens from the terminal"
  description="Every Gitview workflow, from the first release to today, with live demos and screens of the real terminal interface: the agent workspace, history, diffs, staging, commits, branches, and tags."
>
  <Navigation />
  <main class="px-5 pb-16 pt-10 sm:px-8 sm:pt-12">
    <div class="mx-auto max-w-7xl">
      <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-emerald-400">Features</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-semibold tracking-[-0.045em] text-slate-50 sm:text-5xl">Explore the workbench.</h1>
      <div class="mt-5 flex flex-wrap items-baseline gap-x-3 gap-y-1 text-base leading-7 text-slate-400">
        <p>Find a workflow, see it in action. Real terminal captures from Gitview {currentVersion}.</p>
        <a class="inline-flex shrink-0 items-baseline gap-1 whitespace-nowrap text-emerald-300 hover:underline" href={href("changelog/")}>Release notes <span aria-hidden="true">↗</span></a>
      </div>

      <div class="feature-workbench mt-8">
        <aside class="feature-sidebar">
          <label for="feature-search" class="mb-3 block font-mono text-[10px] uppercase tracking-[0.18em] text-slate-500">Find your workflow</label>
          <input id="feature-search" type="search" placeholder="Search features…" autocomplete="off" class="w-full rounded-lg border border-white/10 bg-black/30 px-3 py-3 text-sm text-slate-100 outline-none focus:border-emerald-400" />
          <p id="feature-count" role="status" class="my-3 font-mono text-[10px] text-slate-500">{entries.length} features</p>
          <nav aria-label="Feature catalogue" class="feature-list">
            {entries.map(item => <a href={`#${item.id}`} data-feature-link={item.id} data-search={`${item.title} ${item.body} ${item.since}`.toLowerCase()} class="feature-link">
              <span>{item.title}</span><small>Since {item.since}</small>
            </a>)}
            <p id="feature-empty" hidden class="p-3 text-sm text-slate-400">No matching features. Try “history” or “agent”.</p>
          </nav>
        </aside>
        <div id="feature-panel" class="min-w-0 p-5 sm:p-8">
        {available.map(item => <section data-feature={item.name} id={item.name} class="min-w-0 scroll-mt-24">
          <p class="font-mono text-xs text-emerald-300">Since {item.name === "diff" ? "0.4.0" : "0.3.0"}</p>
          <h2 class="mt-3 text-2xl text-slate-100">{item.title}</h2>
          <p class="my-5 max-w-3xl leading-7 text-slate-400">{item.body}</p>
          <TerminalShot name={item.name} label={item.label} />
        </section>)}
        {features.map(item => <section data-feature={item.id} id={item.id} class="min-w-0 scroll-mt-24">
          <p class="font-mono text-xs text-emerald-300">Since {item.since}</p>
          <h2 class="mt-3 text-2xl text-slate-100">{item.title}</h2>
          <p class="my-5 max-w-3xl leading-7 text-slate-400">{item.body}</p>
          {item.id === "control-channel" && (      <TerminalDemo
        id="agent"
        title="gitview --run sh  ·  agent opens a diff"
        frames={[
          { name: "agent-1", keys: "MCP", caption: "The agent asks Gitview to open README.md with select_file." },
          { name: "agent-2", caption: "Gitview opens the diff on your screen, and tells the agent what it will show." },
        ]}
      />
)}
          {item.id === "sessions" && (      <TerminalDemo
        id="sessions"
        title="gitview  ·  review and merge an agent session"
        frames={[
          { name: "sessions-1", keys: "A", caption: "The Sessions page lists the agent's session, one commit ahead of main." },
          { name: "sessions-2", keys: "Enter", caption: "Review the session's commit and the diff it would bring into main." },
          { name: "sessions-3", keys: "m", caption: "Gitview asks before merging, and says when it would refuse." },
          { name: "sessions-4", keys: "y", caption: "Merged into main with a merge commit; the session is now even with main." },
        ]}
      />
)}
          {item.transcript && <pre class="my-5 whitespace-pre-wrap break-words rounded-xl border border-white/10 bg-[#080e0c] p-4 text-xs leading-6 text-slate-300">{item.transcript.join("\n")}</pre>}
          <div class="flex flex-col gap-6">{item.shots?.map(shot => <TerminalShot name={shot.name} label={shot.label} />)}</div>
        </section>)}
        </div>
      </div>
      <div class="mt-6">
          <a href={href("#install")} class="inline-flex items-center gap-2 rounded-xl border border-emerald-300/25 bg-emerald-300/[0.07] px-4 py-3 font-mono text-xs text-emerald-200 transition hover:border-emerald-300/50 hover:bg-emerald-300/[0.12]">Install Gitview <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .feature-workbench { display: grid; grid-template-columns: 280px minmax(0, 1fr); border: 1px solid #ffffff12; border-radius: 16px; background: #080e0c; }
  .feature-sidebar { padding: 20px; border-right: 1px solid #ffffff12; align-self: start; position: sticky; top: 80px; }
  .feature-list { max-height: calc(100dvh - 260px); overflow-y: auto; }
  .feature-link { display: flex; flex-direction: column; gap: 5px; padding: 12px; margin: 3px 0; border-left: 2px solid transparent; color: #94a3b8; font-size: 13px; line-height: 1.5; border-radius: 0 8px 8px 0; }
  .feature-link small { font-family: monospace; font-size: 10px; color: #64748b; }
  .feature-link:hover { background: #ffffff05; color: #e2e8f0; }
  .feature-link[aria-current] { border-color: #34d399; background: #34d3990d; color: #6ee7b7; }
  .feature-link:focus-visible { outline: 2px solid #34d399; outline-offset: -2px; }
  [hidden] { display: none !important; }
  @media (max-width: 767px) {
    .feature-workbench { grid-template-columns: minmax(0, 1fr); }
    .feature-sidebar { position: static; border-right: 0; border-bottom: 1px solid #ffffff12; }
    .feature-list { max-height: 180px; }
  }
</style>
<script>
  import { setupFeatureBrowser } from "../lib/feature-browser";
  setupFeatureBrowser();
</script>
