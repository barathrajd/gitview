---
import TerminalPreview from "./TerminalPreview.astro";
---

<section id="top" class="relative isolate overflow-hidden px-5 pb-20 pt-20 sm:px-8 sm:pt-28 lg:pb-28 lg:pt-32">
  <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
    <div class="absolute left-1/2 top-0 h-[520px] w-[900px] -translate-x-1/2 rounded-full bg-emerald-400/[0.075] blur-[140px]"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(148,163,184,0.035)_1px,transparent_1px),linear-gradient(to_bottom,rgba(148,163,184,0.035)_1px,transparent_1px)] bg-[size:72px_72px] [mask-image:linear-gradient(to_bottom,black,transparent_72%)]"></div>
  </div>

  <div class="mx-auto max-w-5xl text-center">
    <div class="mb-7 inline-flex items-center gap-2 rounded-full border border-emerald-300/15 bg-emerald-300/[0.05] px-3.5 py-1.5 font-mono text-[11px] tracking-wide text-emerald-200/80 sm:text-xs">
      <span class="size-1.5 rounded-full bg-emerald-400 shadow-[0_0_12px_rgba(52,211,153,0.75)]"></span>
      GIT REVIEW, IN YOUR TERMINAL
      <span class="ml-1 border-l border-emerald-300/20 pl-2 text-slate-500">v0.5.0</span>
    </div>

    <h1 class="mx-auto max-w-4xl text-balance text-5xl font-semibold leading-[1.04] tracking-[-0.055em] text-slate-50 sm:text-6xl lg:text-[76px]">
      Read the whole Git story.<br class="hidden sm:block" />
      {" "}<span class="bg-gradient-to-r from-emerald-300 via-emerald-200 to-cyan-200 bg-clip-text text-transparent">Stay in your terminal.</span>
    </h1>
    <p class="mx-auto mt-7 max-w-2xl text-pretty text-base leading-7 text-slate-400 sm:text-lg sm:leading-8">
      Browse commit history, inspect clear diffs, and stage exactly the changes you want—without leaving your keyboard.
    </p>

    <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a href="#install" class="group inline-flex w-full items-center justify-center gap-3 rounded-xl bg-emerald-300 px-5 py-3.5 font-semibold text-[#06100d] shadow-[0_8px_35px_-12px_rgba(52,211,153,0.75)] transition hover:-translate-y-0.5 hover:bg-emerald-200 sm:w-auto">
        <span class="font-mono text-sm">$</span>
        Install Gitview
        <span class="transition group-hover:translate-x-0.5">→</span>
      </a>
      <a href="https://github.com/barathrajd/gitview" target="_blank" rel="noreferrer" class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-white/10 bg-white/[0.025] px-5 py-3.5 text-sm font-medium text-slate-300 transition hover:border-white/20 hover:bg-white/[0.06] hover:text-white sm:w-auto">
        Browse the source <span class="text-slate-500">↗</span>
      </a>
    </div>

    <p class="mt-4 font-mono text-[11px] text-slate-600">Open source <span class="mx-1 text-slate-700">·</span> MIT license <span class="mx-1 text-slate-700">·</span> macOS Apple Silicon release</p>
  </div>

  <div class="mx-auto mt-16 max-w-6xl sm:mt-20">
    <div class="mb-3 flex items-center justify-between px-1 font-mono text-[10px] uppercase tracking-[0.16em] text-slate-600 sm:px-2">
      <span>Gitview’s current screen layout</span>
      <span>Sample data · panes and key hints match the app</span>
    </div>
    <TerminalPreview />
  </div>
</section>
