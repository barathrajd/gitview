---
// The Gitview mark: two lanes branch from one commit and merge into another,
// outlining an eye, with a commit as the pupil: Git history you can see.
interface Props {
  class?: string;
}
const { class: className = "size-5" } = Astro.props;
---

<svg viewBox="0 0 64 64" fill="none" class={className} aria-hidden="true">
  <g stroke="currentColor" stroke-linecap="round" stroke-width="4.6">
    <path d="M17 32C22 15 42 15 47 32" />
    <path d="M17 32C22 49 42 49 47 32" stroke-opacity="0.6" />
    <circle cx="13.5" cy="32" r="3.6" />
    <circle cx="50.5" cy="32" r="3.6" />
  </g>
  <circle cx="32" cy="32" r="7.4" fill="currentColor" />
</svg>
