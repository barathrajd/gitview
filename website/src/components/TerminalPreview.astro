---
import cockpit from "../assets/cockpit.svg?raw";
import diff from "../assets/diff.svg?raw";

const screens = [
  { id: "cockpit", label: "Main screen: worktree, history, and inspector", svg: cockpit },
  { id: "diff", label: "File diff: Before and After panes with syntax highlighting", svg: diff },
];
---

<div class="mx-auto flex w-full max-w-[1180px] flex-col gap-8 text-left">
  {screens.map((screen) => (
    <figure class="m-0 min-w-0">
      <div
        class="terminal-shell overflow-x-auto rounded-2xl border border-white/[0.11] bg-[#080e0c] shadow-[0_35px_100px_-35px_rgba(16,185,129,0.22)] ring-1 ring-black/50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-emerald-300"
        tabindex="0"
        role="group"
        aria-label={`${screen.label} (scrolls horizontally on narrow screens)`}
      >
        <div class="min-w-[900px]" set:html={screen.svg} />
      </div>
      <figcaption class="mt-3 px-1 font-mono text-[10px] uppercase tracking-[0.14em] text-slate-600">{screen.label}</figcaption>
    </figure>
  ))}
</div>
