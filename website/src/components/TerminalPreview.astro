<div class="terminal-shell relative mx-auto w-full max-w-[1180px] overflow-hidden rounded-2xl border border-white/[0.11] bg-[#080e0c] text-left shadow-[0_35px_100px_-35px_rgba(16,185,129,0.22)] ring-1 ring-black/50">
  <div class="flex flex-wrap items-center gap-x-5 gap-y-2 border-b border-white/[0.08] px-4 py-3 sm:px-5">
    <span class="bg-emerald-300 px-2 py-1 font-mono text-[11px] font-bold tracking-wide text-[#06100d]">GITVIEW</span>
    <span class="font-mono text-[11px] font-medium text-slate-200 sm:text-xs">sample-repo</span>
    <span class="font-mono text-[10px] text-slate-500 sm:text-xs">branch: <span class="text-slate-300">main</span></span>
    <span class="font-mono text-[10px] text-slate-500 sm:text-xs">account: <span class="text-slate-300">Primary</span></span>
  </div>

  <div class="grid min-h-[320px] grid-cols-1 lg:grid-cols-[0.82fr_1.42fr_0.92fr]">
    <section class="border-b border-white/[0.07] lg:border-r lg:border-b-0" aria-label="Worktree pane">
      <h2 class="border-b border-white/[0.06] px-3 py-2 font-mono text-[11px] font-semibold text-slate-500">WORKTREE</h2>
      <div class="p-3 font-mono text-[11px] leading-6 sm:text-xs">
        <p class="text-slate-300">Working tree clean</p>
        <div class="mt-4 space-y-1 text-slate-600">
          <p><span class="text-emerald-500">●</span> Staged <span class="float-right">0</span></p>
          <p><span class="text-amber-400">●</span> Changed <span class="float-right">0</span></p>
          <p><span class="text-cyan-400">●</span> Untracked <span class="float-right">0</span></p>
        </div>
      </div>
    </section>

    <section class="min-w-0 border-b border-white/[0.07] lg:border-r lg:border-b-0" aria-label="History pane">
      <h2 class="border-b border-white/[0.06] px-3 py-2 font-mono text-[11px] font-semibold text-emerald-300">HISTORY</h2>
      <div class="space-y-0.5 overflow-hidden p-2 font-mono text-[10px] leading-[1.8] sm:p-3 sm:text-[11px]">
        <p class="truncate rounded bg-white/[0.05] px-2 py-0.5 text-slate-100"><span class="mr-2 text-emerald-400">›</span><span class="text-emerald-300">●</span> 4b8c2d1 <span class="text-slate-300">feat: add branch filters</span></p>
        <p class="truncate px-2 text-slate-400"><span class="mr-2 text-emerald-700">│</span><span class="text-slate-500">●</span> a91f73c <span class="text-slate-500">fix: refresh worktree state</span></p>
        <p class="truncate px-2 text-slate-400"><span class="mr-2 text-emerald-700">│</span><span class="text-slate-500">●</span> d6021ae <span class="text-slate-500">feat: show commit details</span></p>
        <p class="truncate px-2 text-slate-400"><span class="mr-2 text-emerald-700">│</span><span class="text-slate-500">●</span> 72ce4a0 <span class="text-slate-500">chore: update dependencies</span></p>
        <p class="truncate px-2 text-slate-500"><span class="mr-2 text-emerald-700">╰─</span><span class="text-slate-600">●</span> 1f68b20 <span class="text-slate-600">docs: clarify install steps</span></p>
      </div>
    </section>

    <section class="min-w-0" aria-label="Inspector pane">
      <h2 class="border-b border-white/[0.06] px-3 py-2 font-mono text-[11px] font-semibold text-slate-500">INSPECTOR</h2>
      <div class="space-y-4 p-3 font-mono text-[10px] leading-5 sm:text-[11px]">
        <div>
          <p class="font-semibold text-cyan-300">REPOSITORY</p>
          <p class="break-all text-slate-400">sample-repo</p>
        </div>
        <div>
          <p class="font-semibold text-cyan-300">BRANCH</p>
          <p class="text-slate-300">main</p>
        </div>
        <div>
          <p class="font-semibold text-cyan-300">SELECTED COMMIT</p>
          <p class="break-words text-slate-300">4b8c2d1 · feat: add branch filters</p>
        </div>
        <div>
          <p class="font-semibold text-cyan-300">WORKTREE SUMMARY</p>
          <p class="text-slate-400">0 staged · 0 changed · 0 untracked</p>
        </div>
      </div>
    </section>
  </div>

  <div class="border-t border-white/[0.08] bg-[#060b09]">
    <div class="flex flex-wrap items-center gap-x-5 gap-y-1 border-b border-white/[0.05] px-3 py-2 font-mono text-[9px] uppercase tracking-wide sm:px-4 sm:text-[10px]">
      <span><b class="font-semibold text-emerald-300">STAGED</b> <span class="text-slate-400">0</span></span>
      <span><b class="font-semibold text-amber-300">CHANGES</b> <span class="text-slate-400">0</span></span>
      <span><b class="font-semibold text-cyan-300">UNTRACKED</b> <span class="text-slate-400">0</span></span>
      <span class="ml-auto font-mono normal-case tracking-normal text-slate-500">main</span>
    </div>
    <div class="flex flex-wrap gap-x-4 gap-y-2 px-3 py-2 font-mono text-[9px] text-slate-500 sm:px-4 sm:text-[10px]">
      <span><kbd class="text-slate-200">Tab</kbd> pane</span>
      <span><kbd class="text-slate-200">W</kbd> worktree</span>
      <span><kbd class="text-slate-200">Enter/l</kbd> details</span>
      <span><kbd class="text-slate-200">b</kbd> branches</span>
      <span><kbd class="text-slate-200">p</kbd> profiles</span>
      <span><kbd class="text-slate-200">/</kbd> search</span>
      <span><kbd class="text-slate-200">j/k</kbd> move</span>
      <span><kbd class="text-slate-200">?</kbd> help</span>
      <span><kbd class="text-slate-200">q</kbd> quit</span>
    </div>
  </div>
</div>
