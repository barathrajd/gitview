---
interface Props {
  name: string;
  label: string;
}
const { name, label } = Astro.props;
// Desktop screens are captured at 140 columns; phone screens at 64 columns from the
// same binary, so the text stays readable without any horizontal scrolling.
const desktop = import.meta.glob("../assets/*.svg", { query: "?raw", import: "default", eager: true }) as Record<string, string>;
const mobile = import.meta.glob("../assets/m/*.svg", { query: "?raw", import: "default", eager: true }) as Record<string, string>;
const wide = desktop[`../assets/${name}.svg`];
const narrow = mobile[`../assets/m/${name}.svg`] ?? wide;
---

<figure class="m-0 min-w-0">
  <div class="overflow-hidden rounded-xl border border-white/[0.11] bg-[#080e0c] shadow-[0_35px_100px_-35px_rgba(16,185,129,0.18)] ring-1 ring-black/50 sm:rounded-2xl">
    <div class="hidden md:block" set:html={wide} />
    <div class="md:hidden" set:html={narrow} />
  </div>
  <figcaption class="mt-3 px-1 font-mono text-[10px] uppercase tracking-[0.14em] text-slate-600">{label}</figcaption>
</figure>
