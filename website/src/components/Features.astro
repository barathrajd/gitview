---
const features = [
  {
    index: "01",
    title: "History you can navigate",
    description:
      "Follow the commit graph with branch and tag labels, search history, filter by file or directory, and compare two commits on one page.",
    icon: "history",
    accent: "text-emerald-300",
  },
  {
    index: "02",
    title: "Before and after, highlighted",
    description:
      "Review syntax-colored Before and After panes with aligned, wrapped lines. Switch to raw patch styling or a unified layout with a key.",
    icon: "diff",
    accent: "text-cyan-300",
  },
  {
    index: "03",
    title: "Stage the part you mean",
    description:
      "See staged, changed, and untracked files in groups. Stage or unstage selected hunks, whole files, or everything, and confirm before you discard.",
    icon: "stage",
    accent: "text-amber-300",
  },
  {
    index: "04",
    title: "Commit without leaving",
    description:
      "Write a subject and description in the composer, or press Ctrl+E to use your Git editor. Amend HEAD after reviewing the warning. Hooks and signing stay on.",
    icon: "commit",
    accent: "text-cyan-200",
  },
  {
    index: "05",
    title: "Local branches and tags",
    description:
      "Browse, create, switch, rename, and delete local branches, return to the previous branch, and list, create, verify, or delete local tags.",
    icon: "branch",
    accent: "text-emerald-200",
  },
  {
    index: "06",
    title: "The right account, per folder",
    description:
      "Map folder trees to Git config profiles so each repository uses the matching account, shown in the header. Press ? any time for help on the current page.",
    icon: "profile",
    accent: "text-amber-200",
  },
];

---

<section id="features" class="relative px-5 py-24 sm:px-8 sm:py-32">
  <div class="mx-auto max-w-7xl">
    <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
      <div>
        <p class="font-mono text-[11px] font-semibold uppercase tracking-[0.2em] text-emerald-400">A focused Git workspace</p>
        <h2 class="mt-4 max-w-xl text-3xl font-semibold tracking-[-0.04em] text-slate-100 sm:text-4xl">From commit graph to the exact line you want to stage.</h2>
      </div>
      <p class="max-w-xl text-base leading-7 text-slate-400 lg:justify-self-end">
        Gitview keeps the everyday local loop close at hand: understand what changed, inspect the context, choose what belongs in the index, and commit it.
      </p>
    </div>

    <div class="mt-12 grid gap-px overflow-hidden rounded-2xl border border-white/[0.08] bg-white/[0.08] sm:grid-cols-2">
      {features.map((feature) => (
        <article class="group relative min-h-64 bg-[#080d0b] p-6 transition hover:bg-[#0a120f] sm:p-8">
          <div class="flex items-start justify-between">
            <span class:list={["grid size-11 place-items-center rounded-xl border border-white/[0.08] bg-white/[0.025]", feature.accent]} aria-hidden="true">
              {feature.icon === "history" && (
                <svg viewBox="0 0 24 24" fill="none" class="size-5"><path d="M4 6h5v5H4zM15 13h5v5h-5zM9 8.5h2a4 4 0 0 1 4 4V13M6.5 11v5a2 2 0 0 0 2 2H15" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /></svg>
              )}
              {feature.icon === "diff" && (
                <svg viewBox="0 0 24 24" fill="none" class="size-5"><path d="M7 4H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h2M17 4h2a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-2M8 8h3M8 12h3M8 16h3M13 8h3M13 12h3M13 16h3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
              )}
              {feature.icon === "stage" && (
                <svg viewBox="0 0 24 24" fill="none" class="size-5"><path d="M12 4v16M4 12h16M7 7l10 10M17 7 7 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity=".45" /><path d="M12 8v8M8 12h8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
              )}
              {feature.icon === "commit" && (
                <svg viewBox="0 0 24 24" fill="none" class="size-5"><circle cx="12" cy="12" r="3.5" stroke="currentColor" stroke-width="1.5" /><path d="M3 12h5.5M15.5 12H21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
              )}
              {feature.icon === "profile" && (
                <svg viewBox="0 0 24 24" fill="none" class="size-5"><circle cx="12" cy="8" r="3.5" stroke="currentColor" stroke-width="1.5" /><path d="M5 20c.8-3.6 3.4-5.5 7-5.5s6.2 1.9 7 5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
              )}
              {feature.icon === "branch" && (
                <svg viewBox="0 0 24 24" fill="none" class="size-5"><circle cx="6" cy="5" r="2" stroke="currentColor" stroke-width="1.5" /><circle cx="18" cy="19" r="2" stroke="currentColor" stroke-width="1.5" /><circle cx="18" cy="5" r="2" stroke="currentColor" stroke-width="1.5" /><path d="M6 7v9a3 3 0 0 0 3 3h7M18 7v4a3 3 0 0 1-3 3h-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
              )}
            </span>
            <span class="font-mono text-xs text-slate-700">{feature.index}</span>
          </div>
          <h3 class="mt-10 text-lg font-semibold tracking-tight text-slate-100">{feature.title}</h3>
          <p class="mt-3 max-w-md text-sm leading-6 text-slate-400">{feature.description}</p>
          <div class="absolute bottom-0 left-8 right-8 h-px origin-left scale-x-0 bg-gradient-to-r from-emerald-300/40 to-transparent transition-transform duration-500 group-hover:scale-x-100" aria-hidden="true"></div>
        </article>
      ))}
    </div>

    <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2 font-mono text-[10px] uppercase tracking-wider text-slate-600">
      <span>Rust + Ratatui</span><span class="text-slate-800">/</span><span>keyboard-first</span><span class="text-slate-800">/</span><span>local Git workflows</span><span class="text-slate-800">/</span><span>no remote operations yet</span>
    </div>
  </div>
</section>
