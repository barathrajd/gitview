---
import { href } from "../lib/base";
---
<header class="sticky top-0 z-20 border-b border-white/[0.07] bg-[#050908]/85 backdrop-blur-xl">
  <nav
    class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 sm:px-8"
    aria-label="Main navigation"
  >
    <a href={href()} class="group flex items-center gap-3" aria-label="Gitview home">
      <span class="grid size-9 place-items-center rounded-xl border border-emerald-300/20 bg-emerald-300/[0.08] text-emerald-300 transition group-hover:border-emerald-300/50 group-hover:bg-emerald-300/[0.13]" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" class="size-5">
          <path d="M5 5h5a7 7 0 1 1 0 14H9V8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          <path d="m14 9 3 3-3 3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
      <span class="font-mono text-[15px] font-semibold tracking-tight text-slate-100">gitview<span class="text-emerald-400">.</span></span>
    </a>

    <div class="flex items-center gap-3 sm:gap-8">
      <a href={href("features/")} class="hidden text-sm text-slate-400 transition hover:text-slate-100 sm:inline">Features</a>
      <a href={href("changelog/")} class="hidden text-sm text-slate-400 transition hover:text-slate-100 sm:inline">Changelog</a>
      <a href={href("#install")} class="hidden text-sm text-slate-400 transition hover:text-slate-100 sm:inline">Install</a>
      <a
        href="https://github.com/barathrajd/gitview"
        class="inline-flex items-center gap-2 rounded-full border border-white/10 px-3 py-2 text-sm sm:px-4 font-medium text-slate-200 transition hover:border-emerald-300/30 hover:bg-white/[0.04]"
        target="_blank"
        rel="noreferrer"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" class="size-4" aria-hidden="true">
          <path fill-rule="evenodd" d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.18-3.37-1.18-.45-1.15-1.11-1.46-1.11-1.46-.91-.62.07-.61.07-.61 1 .07 1.52 1.03 1.52 1.03.9 1.52 2.35 1.08 2.93.82.09-.64.35-1.08.63-1.33-2.22-.26-4.55-1.11-4.55-4.95 0-1.09.39-1.98 1.03-2.68-.1-.26-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02A9.58 9.58 0 0 1 12 6.98c.85 0 1.7.11 2.5.34 1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.39.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.85-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.75c0 .26.18.57.69.48A10 10 0 0 0 12 2Z" clip-rule="evenodd" />
        </svg>
        <span>GitHub</span>
        <span class="font-mono text-xs text-slate-500">↗</span>
      </a>
      <button
        type="button"
        class="grid size-10 place-items-center rounded-xl border border-white/10 text-slate-300 transition hover:border-emerald-300/30 hover:bg-white/[0.04] focus-visible:outline focus-visible:outline-2 focus-visible:outline-emerald-300 sm:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-button
      >
        <svg viewBox="0 0 24 24" fill="none" class="size-5" aria-hidden="true">
          <path data-menu-open d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          <path data-menu-close class="hidden" d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </nav>
  <div id="mobile-menu" class="border-t border-white/[0.07] bg-[#050908] px-5 pb-5 pt-2 sm:hidden" hidden data-menu>
    <ul class="flex flex-col">
      <li><a href={href("features/")} class="block border-b border-white/[0.06] py-4 text-base text-slate-200 transition hover:text-emerald-200">Features</a></li>
      <li><a href={href("changelog/")} class="block border-b border-white/[0.06] py-4 text-base text-slate-200 transition hover:text-emerald-200">Changelog</a></li>
      <li><a href={href("#install")} class="block border-b border-white/[0.06] py-4 text-base text-slate-200 transition hover:text-emerald-200">Install</a></li>
      <li><a href="https://github.com/barathrajd/gitview" target="_blank" rel="noreferrer" class="block py-4 text-base text-slate-200 transition hover:text-emerald-200">GitHub source <span class="text-slate-500">↗</span></a></li>
    </ul>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-menu-button]");
  const menu = document.querySelector<HTMLElement>("[data-menu]");
  if (button && menu) {
    const openIcon = button.querySelector("[data-menu-open]");
    const closeIcon = button.querySelector("[data-menu-close]");
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      button.setAttribute("aria-expanded", String(open));
      button.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      openIcon?.classList.toggle("hidden", open);
      closeIcon?.classList.toggle("hidden", !open);
    };
    button.addEventListener("click", () => setOpen(menu.hidden));
    menu.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) setOpen(false);
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !menu.hidden) {
        setOpen(false);
        button.focus();
      }
    });
    // Close the menu when the window grows past the phone layout.
    window.matchMedia("(min-width: 640px)").addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
